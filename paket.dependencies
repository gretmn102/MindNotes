strategy: min
source https://api.nuget.org/v3/index.json
framework: netcoreapp3.1, netstandard2.0
storage: none

group Client
    strategy: min
    source https://api.nuget.org/v3/index.json
    framework: netstandard2.0
    storage: none

    nuget FSharp.Core = 6.0.7
    nuget Fable.Browser.Dom = 2.14
    nuget Fable.Core = 4.0
    nuget Fable.Elmish = 4.0.2
    nuget Fable.Elmish.React = 4.0
    nuget Fable.Elmish.Debugger >= 4.0 lowest_matching: true
    nuget Fable.Elmish.HMR >= 7.0 lowest_matching: true
    nuget Fable.FontAwesome.Free = 3.0
    nuget Fable.React = 9.3
    nuget Fable.Remoting.Client = 7.25.0
    nuget Fulma = 3.0
    nuget Fulma.Extensions.Wikiki.Checkradio >= 3.0 lowest_matching: true
    nuget Feliz = 2.6
    nuget Feliz.Router >= 4.0 lowest_matching: true
    nuget Fable.Browser.Navigator >= 2.4 lowest_matching: true
    nuget Zanaptak.TypedCssClasses = 1.0

    source https://gitlab.com/api/v4/projects/28574921/packages/nuget/index.json
    nuget FulmaExtensions  >= 0.1 lowest_matching: true

group ClientTests
    strategy: min
    source https://api.nuget.org/v3/index.json
    framework: netstandard2.0
    storage: none

    nuget FSharp.Core = 6.0.7
    nuget Fable.Mocha = 2.17

group Shared
    strategy: min
    source https://api.nuget.org/v3/index.json
    framework: netstandard2.0
    storage: none

    nuget FParsec

    source https://gitlab.com/api/v4/projects/28574921/packages/nuget/index.json
    nuget FSharpMyExt 2.0.0-prerelease.4
    nuget FUniversalParser >= 0.5 lowest_matching: true

group Server
    strategy: min
    source https://api.nuget.org/v3/index.json
    framework: netcoreapp3.1
    storage: none

    nuget FSharp.Core = 6.0.7
    nuget Fable.Remoting.Giraffe = 4.9
    nuget Markdig = 0.22.1
    nuget Saturn = 0.14.1
    nuget StringComparison >= 1.0.3 lowest_matching: true

    source https://gitlab.com/api/v4/projects/28574921/packages/nuget/index.json
    nuget FSharpMyExt 2.0.0-prerelease.4

group ServerTests
    strategy: min
    source https://api.nuget.org/v3/index.json
    framework: netcoreapp3.1
    storage: none

    nuget FSharp.Core = 6.0.7
    nuget Expecto = 9.0.2

group SharedTests
    strategy: min
    source https://api.nuget.org/v3/index.json
    framework: netcoreapp3.1
    storage: none

    nuget FSharp.Core = 6.0.7
    nuget Expecto = 9.0.2
    nuget Fable.Mocha = 2.17

group Build
    strategy: min
    source https://api.nuget.org/v3/index.json
    framework: netstandard2.0
    storage: none

    nuget FSharp.Core < 6
    nuget Fake.Core.ReleaseNotes < 6
    nuget Fake.Core.Target < 6
    nuget Fake.DotNet.Cli < 6
    nuget Fake.IO.FileSystem < 6